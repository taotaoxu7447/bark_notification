# AgentWatch site on SH_VPS. The API path is kept intact upstream.
https://aw.taotaoxu.net {
	# Copy the two public source PNGs into /var/www/agentwatch-public/icons/.
	@agentwatch_source_icons path /icons/deepseek-icon-v1.png /icons/omp-icon-v1.png
	handle @agentwatch_source_icons {
		root * /var/www/agentwatch-public
		header Cache-Control "public, max-age=86400"
		file_server
	}
	header -Server

	# ntfy v2.26.3 account tokens can enumerate, create, and revoke every
	# token on its ntfy principal. The custom WebSocket client does not use
	# this API, so it must never be exposed for subscriber tokens.
	handle /v1/account* {
		respond 404
	}

	handle /agentwatch/api/v1/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:2587 {
			# Overwrite, rather than append to, any client-supplied value. The
			# loopback API trusts this header for its per-IP rate limit.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:2586
	}
}
