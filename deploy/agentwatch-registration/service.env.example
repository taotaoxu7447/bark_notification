# Copy to /etc/agentwatch-registration/service.env, replace placeholders, then
# set ownership root:ntfy and mode 0640. Never commit the deployed file.
AGENTWATCH_INVITE_CODE=replace-with-at-least-32-random-characters
AGENTWATCH_NTFY_PUBLISHER_TOKEN=tk_replace_with_private_write_only_token

# Non-secret deployment metadata follows.
AGENTWATCH_DATABASE_PATH=/var/lib/agentwatch-registration/registration.db
AGENTWATCH_NTFY_BINARY=/usr/bin/ntfy
AGENTWATCH_NTFY_CONFIG_FILE=/etc/ntfy/server.yml
AGENTWATCH_NTFY_SUBSCRIBER_USER=agent-watch-subscriber
AGENTWATCH_NTFY_INTERNAL_URL=http://127.0.0.1:2586/agent-watch
AGENTWATCH_NTFY_PUBLIC_URL=https://64.90.8.184:9444/agent-watch
AGENTWATCH_NTFY_TOPIC=agent-watch
