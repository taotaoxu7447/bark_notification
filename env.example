# Copy this file to ~/.codex-watch-notifier/env and fill in at least one notification channel.
# Keep the real env file private: push tokens and webhook URLs are secrets.

# Bark, for iPhone / Apple Watch push notifications.
BARK_URL=
BARK_KEY=
BARK_LEVEL=timeSensitive
CODEX_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/codex-icon-large-v1.png
CODEX_BARK_GROUP=Codex
ZCODE_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/zcode-icon-v1.png
ZCODE_BARK_GROUP=ZCode
KIMI_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/kimi-icon-v1.png
KIMI_BARK_GROUP=Kimi Code
GROK_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/grok-icon-v1.png
GROK_BARK_GROUP=Grok Build
CLAUDE_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/android/app/src/main/res/drawable-nodpi/source_claude.png
CLAUDE_BARK_GROUP=Claude Code
PI_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/pi-icon-v1.png
PI_BARK_GROUP=Pi Agent
OPENCODE_BARK_ICON=https://raw.githubusercontent.com/taotaoxu7447/bark_notification/main/assets/opencode-icon-v1.png
OPENCODE_BARK_GROUP=OpenCode

# AgentWatch Android private delivery API. This endpoint is public metadata;
# `agentwatch login` stores the account-bound computer token outside this file.
# Never put an account password or computer token in env/configuration.
AGENTWATCH_API_BASE=https://64.90.8.184:9444/agentwatch/api/v1
AGENTWATCH_PRIORITY=default

# Optional channels. Leave empty unless explicitly needed.
CODEX_NOTIFY_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
CODEX_NOTIFY_COMMAND=

# Runtime options.
CODEX_WATCH_MACOS_NOTIFICATION=0
CODEX_WATCH_POLL_INTERVAL=2
# A failed event gets at most one delayed retry. Values above 2 are clamped to 2.
NOTIFY_DELIVERY_MAX_ATTEMPTS=2
# The second attempt is never immediate; values below 30 seconds are clamped to 30.
NOTIFY_DELIVERY_RETRY_DELAY_SECONDS=60
# Codex 5.6 may create many child agents. Keep their events silent by default.
# Set 1 only when you explicitly need notifications from every subagent.
CODEX_WATCH_NOTIFY_SUBAGENTS=0
# Skip old Codex completion events when rollout files are rewritten by account/session tools.
# Set 0 to disable. Default is 3600 seconds.
CODEX_WATCH_MAX_EVENT_AGE_SECONDS=3600
ZCODE_WATCH_ENABLED=1
ZCODE_WATCH_LOG_ROOT=~/.zcode/cli/log
KIMI_WATCH_ENABLED=1
KIMI_WATCH_SESSIONS_ROOT=~/.kimi-code/sessions
# Kimi can create child agents. Keep them silent unless explicitly needed.
KIMI_WATCH_NOTIFY_SUBAGENTS=0
GROK_WATCH_ENABLED=1
GROK_WATCH_SESSIONS_ROOT=~/.grok/sessions
# Grok child sessions have parent_session_id and are silent by default.
GROK_WATCH_NOTIFY_SUBAGENTS=0
# Claude Code uses only the official Stop and StopFailure hooks. SubagentStop is
# deliberately not configured, so child-agent completions stay silent.
CLAUDE_WATCH_ENABLED=1
# Optional override. Empty uses <AGENTWATCH_CONFIG_DIR>/claude-hook-events.jsonl.
CLAUDE_WATCH_EVENTS_FILE=
# Claude runs matching Stop hooks in parallel. Hold the first false Stop long
# enough to catch a later matching true Stop without spending a delivery try.
# Default 10s favors timely alerts but does not cover the official 30s
# prompt-hook timeout. Values are clamped to 5..600; slow blockers beyond the
# selected window can still produce an early provisional alert. Transcript
# growth alone is not suppression evidence because Claude writes it async.
CLAUDE_WATCH_STOP_SETTLE_SECONDS=10
# Consumed data rotates at 4 MiB or 24 hours, whichever comes first. These are
# soft retention limits: unread/retrying records and the short safe drain are
# never truncated. Minimums are 65536 bytes and 3600 seconds.
CLAUDE_WATCH_SPOOL_MAX_BYTES=4194304
CLAUDE_WATCH_SPOOL_MAX_AGE_SECONDS=86400
# Pi Agent 0.80.4+ uses the official global `agent_settled` extension event.
# Persisted interactive sessions are enabled; JSON/no-session child runs stay silent.
PI_WATCH_ENABLED=1
# Forked/cloned Pi sessions contain parentSession and stay silent by default.
PI_WATCH_NOTIFY_FORKED_SESSIONS=0
# OpenCode 1.15.11+ uses its official global plugin `session.idle` event and
# awaited `dispose` lifecycle. Sessions with parentID are child sessions and stay silent.
OPENCODE_WATCH_ENABLED=1

# Privacy controls. Set to 0 for less sensitive notification bodies.
NOTIFY_INCLUDE_WORKSPACE=1
NOTIFY_INCLUDE_MESSAGE=1
NOTIFY_BODY_MAX_CHARS=1100
